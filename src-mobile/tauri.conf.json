{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handy",
  "version": "0.1.0",
  "identifier": "com.handy.mobile",
  "build": {
    "beforeDevCommand": "bun --cwd src-mobile-ui run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun --cwd src-mobile-ui run build",
    "frontendDist": "../src-mobile-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Handy",
        "width": 400,
        "height": 720
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.icns",
      "../src-tauri/icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
